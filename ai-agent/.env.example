# ===== 大模型（DashScope OpenAI 兼容接口）=====
# 通义千问 API Key（阿里云百炼控制台申请），必填 —— 请填到 .env（勿提交真实值）
DASHSCOPE_API_KEY=
# OpenAI 兼容基址，一般无需修改
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 对话模型与向量模型
CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
TEMPERATURE=0.7

# ===== 鉴权 =====
# 必须与 Java 后端 application.yml 的 jwt.secret 完全一致（同一 Base64 串），否则 token 校验失败
JWT_SECRET=U2VhdFJlc2VydmF0aW9uU3lzdGVtQnlMRU9IRVJPMjAyNQ==

# ===== 调用 Java 业务底座内部接口 =====
# Java 服务地址（docker-compose 内为 http://app:8080，本地开发为 http://localhost:8080）
JAVA_INTERNAL_BASE_URL=http://localhost:8080
# 服务间鉴权 token，必须与 Java 的 internal.api.token 一致（生产请用随机强密钥并走环境变量）
INTERNAL_API_TOKEN=

# ===== 会话记忆（LangGraph SQLite）=====
DB_PATH=db/reservation_agent.db

# ===== 知识库（RAG）=====
KNOWLEDGE_DIR=knowledge
RAG_TOP_K=4

# ===== 服务端口 =====
PORT=8000
